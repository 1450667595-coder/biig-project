# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production

# Database
DATABASE_URL=postgresql://codeflow:codeflow@localhost:5432/codeflow

# Redis
REDIS_URL=redis://localhost:6379

# Model API Keys (at least one required)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Default routing
DEFAULT_CHAT_MODEL=deepseek/deepseek-chat
DEFAULT_CODE_MODEL=deepseek/deepseek-coder
DEFAULT_REASONING_MODEL=deepseek/deepseek-reasoner
